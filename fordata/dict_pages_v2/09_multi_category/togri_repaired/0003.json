        "idioms": []
      },
      {
        "order_sort": 3,
        "categorys": [
          "сп."
        ],
        "text": "Шахмат ойынындағы ат, король, пил ҳәм.т.б.",
        "idioms": []
      },
      {
        "order_sort": 4,
        "categorys": [
          "әд."
