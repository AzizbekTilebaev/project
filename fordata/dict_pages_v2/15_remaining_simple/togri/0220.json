        ],
        "text": "Усталардың қуралларын салатуғын кишкене кутыша.",
        "idioms": []
      }
    ]
  },
  {
    "title": "ҚОБЫЗШЫ",
    "full_text": "ҚОБЫЗШЫ ат. Қобыз бенен жырлайтуғын адам.",
    "source": "4_1",
    "roman": null,
    "ref": null,
