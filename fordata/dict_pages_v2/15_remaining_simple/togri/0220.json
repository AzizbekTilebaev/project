    ]
  },
  {
    "title": "ҚОЖАЛАҚ ІІ",
    "full_text": "ҚОЖАЛАҚ ІІ ат. териден исленген маска.",
    "source": "4_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
