  {
    "title": "ҚОЖЫҚ",
    "full_text": "ҚОЖЫҚ кел. Күшли, үлкен, зор. Бозығым, бозығым, Божығым, божығым, Қожығым, қожығым, Қонжығым, қонжығым! (Ер балаға арналған сүймишлер)",
    "source": "4_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "кел."
        ],
        "text": "Күшли, үлкен, зор. Бозығым, бозығым, Божығым, божығым, Қожығым, қожығым, Қонжығым, қонжығым! (Ер балаға арналған сүймишлер)",
        "idioms": []
