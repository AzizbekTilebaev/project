        "idioms": []
      }
    ]
  },
  {
    "title": "ҚОҒАЛЫ",
    "full_text": "ҚОҒАЛЫ кел. Қоғасы бар, қоғаға ийе.",
    "source": "4_1",
    "roman": null,
    "ref": null,
