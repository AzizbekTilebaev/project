  {
    "title": "ЫЗҒАРЛАЎ І",
    "full_text": "ЫЗҒАРЛАЎ І кел. Ығаллаў, хөллеў, ләмлеў. ІІ Ф. Ләм болып қалыў, хөл болыў, ығал болыў.",
    "source": "7_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
