        "idioms": []
      }
    ]
  },
  {
    "title": "ЫҚ ІІ",
    "full_text": "ЫҚ ІІ ат. Қырмандағы дәнниң атылғандағы кепеғи, кОҒЫ.",
    "source": "7_1",
    "roman": null,
