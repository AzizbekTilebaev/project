      }
    ]
  },
  {
    "title": "ЫЗЫҢСЫЗ",
    "full_text": "ЫЗЫҢСЫЗ кел. Ызыңы жоқ, ызыңламаған.",
    "source": "7_1",
    "roman": null,
    "ref": null,
