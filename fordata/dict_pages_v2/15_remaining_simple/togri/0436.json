  {
    "title": "ТАРАЎЛЫ",
    "full_text": "ТАРАЎЛЫ кел. Салалы, тармақлы, бөлимли. Хожели районы Республикалық көп тараўлы санаториясы балаларды қабыллаў ушын таяр ҳалға келтирилди (Интернет мағлыўматлары).",
    "source": "7_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "кел."
        ],
        "text": "Салалы, тармақлы, бөлимли. Хожели районы Республикалық көп тараўлы санаториясы балаларды қабыллаў ушын таяр ҳалға келтирилди (Интернет мағлыўматлары).",
        "idioms": []
      }
    ]
  },
  {
    "title": "ТАРАЎСЫЗ",
    "full_text": "ТАРАЎСЫЗ кел. Тараўы жоқ, бөлимсиз, саласыз, тармақсыз. Ҳәр қандай өндирис тийкарында химиялык процесслер жатады, бул тараўсыз экономикада раўажланыў болмайды (Интернет мағлыўматлары).",
    "source": "7_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "кел."
        ],
        "text": "Тараўы жоқ, бөлимсиз, саласыз, тармақсыз. Ҳәр қандай өндирис тийкарында химиялык процесслер жатады, бул тараўсыз экономикада раўажланыў болмайды (Интернет мағлыўматлары).",
        "idioms": []
      }
    ]
  },
  {
    "title": "ТАРАШ",
    "full_text": "ТАРАШ ат. Ылайдан салынған пақсаны, қазылған жаптың, салманың, үлкен арналардың қапталларына теғислеўдеғи исленетуғын ҳәрекет, ис.",
    "source": "7_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "ат."
        ],
        "text": "Ылайдан салынған пақсаны, қазылған жаптың, салманың, үлкен арналардың қапталларына теғислеўдеғи исленетуғын ҳәрекет, ис.",
        "idioms": []
      }
    ]
  },
  {
    "title": "ТАРАША",
    "full_text": "ТАРАША ат. Самовар қайнатыўға ылайықлап кесилген ағаш. Бир отқа тарашалап ағаш жағайық дейди (КДС).",
