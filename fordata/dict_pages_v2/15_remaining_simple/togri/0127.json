    "title": "ЖУҒЫМТАЛЛЫ",
    "full_text": "ЖУҒЫМТАЛЛЫ кел. Пайдалы, унамлы, жуғымлық.",
    "source": "3_1",
    "roman": null,
    "ref": null,
