    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [],
        "text": "етилік ат. Соқтаның жети қаты, жетиниң орнына жүретуғын. Қолыңдағы жалғыз жетиликти услап отыра бер. Жетилисиу жетилиу феилінің шериклик дәрежесі.",
        "idioms": []
      }
    ]
