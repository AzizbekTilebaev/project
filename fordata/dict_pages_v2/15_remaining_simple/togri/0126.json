  {
    "title": "ЖӨНЛИ",
    "full_text": "ЖӨНЛИ кел. Дурыс, оңлы. Айдостың атын байлаўға, Ҳеш биреўи келмеди, Былай турсын ат байлаў, Жөнли жуўап бермеди (Бердак).",
    "source": "3_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "кел."
        ],
        "text": "Дурыс, оңлы. Айдостың атын байлаўға, Ҳеш биреўи келмеди, Былай турсын ат байлаў, Жөнли жуўап бермеди (Бердак).",
        "idioms": []
      }
    ]
  },
  {
    "title": "ЖӨНСИЗ",
    "full_text": "ЖӨНСИЗ кел. Орынсыз, надурыс, қәте, жөни жок, Анаў турған ене қыз, Қара жерден кемеңиз, Қатты кайырым сөз айтса, Сеники жөнсиз демеңиз (кк.х.с.ж.).",
    "source": "3_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "кел."
        ],
        "text": "Орынсыз, надурыс, қәте, жөни жок, Анаў турған ене қыз, Қара жерден кемеңиз, Қатты кайырым сөз айтса, Сеники жөнсиз демеңиз (кк.х.с.ж.).",
        "idioms": []
      }
    ]
  },
  {
    "title": "ЖӨРГЕКЛИ",
    "full_text": "ЖӨРГЕКЛИ кел. Жөргеги бар, астына жөргек салынған, жөргекке оралған. Билген адам Хантекли дер, Билмегенлер Қандекли дер, Қамка тоннан жөргекли дер, Үшеўи де ялған емес (Бердак).",
    "source": "3_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "кел."
        ],
        "text": "Жөргеги бар, астына жөргек салынған, жөргекке оралған. Билген адам Хантекли дер, Билмегенлер Қандекли дер, Қамка тоннан жөргекли дер, Үшеўи де ялған емес (Бердак).",
        "idioms": []
      }
    ]
  },
  {
    "title": "ЖӨРГЕКТЕЙ",
    "full_text": "ЖӨРГЕКТЕЙ кел. Жөргек сыяқлы, жөргекке усаған, жөргек тәризли.",
