        ],
        "text": "Муртты, сақалды пардозлап қырқатуғын кишкене қайшы.",
        "idioms": []
      }
    ]
  },
  {
    "title": "ДҮМПИШ",
    "full_text": "ДҮМПИШ ат. Урған муш, түйген муш. Жедик бәрҳа байдың дүмпишин, мушын (Омар).",
    "source": "3_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
      {
        "order_sort": 1,
        "categorys": [
          "ат."
        ],
        "text": "Урған муш, түйген муш. Жедик бәрҳа байдың дүмпишин, мушын (Омар).",
        "idioms": []
      }
    ]
  },
  {
    "title": "ДҮНЬЯПУРЫШ",
    "full_text": "ДҮНЬЯПУРЫШ ат. Байлық тапқыш, топлағыш, байлыкка өш.",
    "source": "3_1",
    "roman": null,
    "ref": null,
    "ref_word": null,
    "compound": null,
    "etymology": null,
    "definitions": [
