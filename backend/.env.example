# Copy to .env and fill in real values. Never commit .env.

# Legacy URLs (setup/scripts); runtime asosan DB_* + kk_*
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/qaraqalpaq_db"
DATABASE_QUIZ="mysql://USER:PASSWORD@127.0.0.1:3306/quiz_db"
DATABASE_TUSINDIRME="mysql://USER:PASSWORD@127.0.0.1:3306/kk_tusindirme"

# Strong random secret (openssl rand -base64 48) — productionda ≥32 majburiy
# HECH QACHON namuna parol yozmang (admin123 va h.k.) — bo‘sh qoldiring, .env da to‘ldiring
JWT_SECRET=

# Actor identity HMAC (≥32). Productionda default qabul qilinmaydi.
# openssl rand -base64 48
ACTOR_HMAC_SECRET=

# Optional file URL signing (bo‘sh bo‘lsa ACTOR_HMAC_SECRET / JWT_SECRET)
# FILE_SIGNING_SECRET=

# Optional: protect POST /api/tusindirme/import-nested (openssl rand -hex 32)
# openssl rand -hex 32
IMPORT_API_KEY=

# Admin — productionda kuchli parol majburiy; misolda zaif qiymat qo‘ymang
# Kamida 16 belgi random. Namuna: openssl rand -base64 24
ADMIN_PASSWORD=
# openssl rand -base64 48 (≥32)
ADMIN_SESSION_SECRET=
# Productionda 1 — faqat admin_accounts email login
ADMIN_DISABLE_LEGACY=0
# Seed (bo‘sh jadvallar uchun). Editor/uploader faqat alohida parol berilganda yaratiladi.
# ADMIN_OWNER_EMAIL=owner@local
# ADMIN_OWNER_PASSWORD=
# ADMIN_EDITOR_EMAIL=editor@local
# ADMIN_EDITOR_PASSWORD=
# ADMIN_UPLOADER_EMAIL=uploader@local
# ADMIN_UPLOADER_PASSWORD=

# Book uploads (PDF/DOC/DOCX), relative to backend cwd or absolute
BOOKS_UPLOAD_DIR=public/uploads/books
BOOKS_MAX_UPLOAD_MB=25

# Comma-separated allowed browser origins — productionda aniq https://domen (HECH QACHON *)
FRONTEND_ORIGIN=http://localhost:3000

# Har MySQL pool ulanish soni (10 baza × limit). Prod default 4; kichik VPS da 3
# DB_POOL_LIMIT=4

# Actor yozuv rate-limit (soatiga). Prod tavsiya: 40
# ACTOR_WRITE_LIMIT=40

# Kun so‘zi claim — UTC oraliq (soat), tzOffset firibgarligiga qarshi
# WOD_MIN_CLAIM_HOURS=20

# Sitemap / robots absolute URLs
SITE_ORIGIN=http://localhost:3000

# Behind Nginx set to 1 (or use NODE_ENV=production)
TRUST_PROXY=0

PORT=5000
NODE_ENV=development

# Session TTL (kun). 1–30, default 14. Mobil uchun 30 tavsiya (refresh token yo‘q)
AUTH_SESSION_DAYS=1

# Google Sign-In (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=

# Password reset: optional email delivery
# RESEND_API_KEY=re_xxx
# MAIL_FROM="Qaraqalpaq <onboarding@resend.dev>"
# Devda resetUrl API javobida (faqat non-prod). Productionda hech qachon yoqilmasin.
# AUTH_EXPOSE_RESET_URL=1

# --- Auth prep (default OFF) ---
AUTH_GOOGLE_PEOPLE=0
AUTH_TOTP_2FA=0
AUTH_PHONE_LOGIN=0
AUTH_SMS_ENABLED=0
# AUTH_SHOW_PREP_UI=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=kk_tusindirme

# Aiven / managed MySQL TLS (lokalda odatda o‘chiq)
# DB_SSL=REQUIRED
# DB_SSL_CA=./certs/aiven-ca.pem
# CA yo‘q bo‘lsa (tavsiya etilmaydi): DB_SSL_REJECT_UNAUTHORIZED=0

KK_USERS_DB=kk_users
KK_POETS_DB=kk_poets
KK_POETRYS_DB=kk_poetrys
KK_JUMBAQLAR_DB=kk_jumbaqlar
KK_TUSINDIRME_DB=kk_tusindirme
KK_QUIZ_DB=kk_quiz
KK_KRASVORD_DB=kk_krasvord
KK_STATISTIKA_DB=kk_statistika
KK_AI_DB=kk_ai_db
KK_LOGS_DB=kk_logs
